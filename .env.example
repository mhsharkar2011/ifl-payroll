APP_NAME="IFL Payroll"
APP_ENV=local
APP_KEY=base64:vx1uWOxsh3mMDQ3NircD5bjAC1cWSBepTiX/OTNkm/4=
APP_DEBUG=true
APP_URL=http://192.168.1.9:8081
VITE_APP_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (Docker service name, NOT 127.0.0.1) ─────────
DB_CONNECTION=mysql
DB_HOST=mysql
# DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ifl_payroll
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue: pick ONE (sync for local dev, database/redis for async) ─
QUEUE_CONNECTION=sync

# ─── Cache ─────────────────────────────────────────────────
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

# ─── Redis (Docker service name, NOT 127.0.0.1) ────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# ZKTeco MB460 Device
# ============================================
ZK_TECO_IP=192.168.1.100
ZK_TECO_PORT=4370
ZK_TECO_PASSWORD=1324
ZK_TECO_DEVICE_ID=1
ZK_TECO_TIMEOUT=30
ZK_TECO_MOCK_MODE=false

ICLOCK_PUBLIC_URL=http://192.168.1.9:8081


